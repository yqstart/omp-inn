{
  "name": "omp-inn",
  "version": "0.1.0",
  "description": "oh-my-pi（omp）桌面端聊天工作台（Tauri v2 + React）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yqstart/omp-inn.git"
  },
  "homepage": "https://github.com/yqstart/omp-inn#readme",
  "bugs": {
    "url": "https://github.com/yqstart/omp-inn/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "e2e:ipc": "node scripts/e2e-ipc-selfcheck.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm e2e:ipc",
    "icon": "node scripts/generate-icons.mjs",
    "file-icons": "node scripts/generate-material-icons.mjs"
  },
  "dependencies": {
    "@lexical/react": "0.52.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lexical": "0.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "reicon-react": "^1.2.5",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "material-icon-theme": "5.39.0",
    "tailwindcss": "^4.1.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
